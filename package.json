{
  "name": "focus-english-lab",
  "private": true,
  "version": "0.1.8",
  "description": "Independent browser-based English proficiency practice with original questions, local AI coaching, and optional in-browser TTS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aoml3245/focus-english-lab.git"
  },
  "type": "module",
  "scripts": {
    "prepare:ort": "node scripts/copy-ort-assets.mjs",
    "predev": "npm run prepare:ort",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "tts:download": "node server/download-tts-model.mjs",
    "prebuild": "npm run prepare:ort",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/assert-no-jsep-assets.mjs",
    "prepreview": "npm run prepare:ort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@vitejs/plugin-react": "latest",
    "kokoro-js": "^1.2.1",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "^0.35.4",
    "kokoro-js": {
      "@huggingface/transformers": "4.2.0"
    }
  }
}
