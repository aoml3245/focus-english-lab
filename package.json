{
  "name": "focus-english-lab",
  "private": true,
  "version": "0.1.55",
  "description": "Independent browser-based English proficiency practice with original questions, local AI coaching, and optional in-browser TTS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aoml3245/focus-english-lab.git"
  },
  "type": "module",
  "scripts": {
    "prepare:ort": "node scripts/patch-phonemizer.mjs && node scripts/copy-ort-assets.mjs",
    "predev": "npm run prepare:ort",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "tts:download": "node server/download-tts-model.mjs",
    "vocab:review": "python3 scripts/review_vocabulary.py",
    "vocab:review:durable": "scripts/run_vocabulary_review.sh",
    "vocab:review:sample": "python3 scripts/review_vocabulary.py --limit 120 --merge --output private/vocabulary.json --report work/vocabulary/semantic-quality-report-sample.json --selection-cache work/vocabulary/semantic-selection-sample.jsonl --context-cache work/vocabulary/semantic-context-sample.jsonl --draft-cache work/vocabulary/semantic-draft-sample.jsonl --validation-cache work/vocabulary/semantic-validation-sample.jsonl --cache work/vocabulary/semantic-review-sample.jsonl",
    "vocab:export:public": "python3 scripts/export_public_vocabulary.py",
    "prebuild": "npm run prepare:ort",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/assert-no-jsep-assets.mjs",
    "prepreview": "npm run prepare:ort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@vitejs/plugin-react": "latest",
    "coi-serviceworker": "0.1.7",
    "firebase": "^12.18.0",
    "kokoro-js": "^1.2.1",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "onnxruntime-web": "1.29.0",
    "sharp": "^0.35.4",
    "kokoro-js": {
      "@huggingface/transformers": "4.2.0"
    }
  }
}
